{
  "name": "netlify-proxy-functions",
  "version": "1.0.0",
  "description": "Netlify functions proxy and Maps redirect with static HTML",
  "main": "index.js",
  "scripts": {
    "// Clean the output directory before build": "",
    "clean": "rm -rf ./dist",
    "// Build HTML by substituting env vars using Node.js script": "",
    "build:html": "node ./scripts/build-html.mjs",
    "// Main build command: clean, compile TypeScript, then build HTML (and potentially other assets)": "",
    "build": "npm run clean && npm run tsc && npm run build:html",
    "// Local development server (runs functions and serves static files from 'dist')": "",
    "dev": "netlify dev",
    "// Reminder: Run 'npm run build' manually once before 'npm run dev' to generate ./dist": "",
    "// TypeScript compilation": "",
    "tsc": "tsc",
    "// Linting and formatting": "",
    "lint": "eslint js/**/*.ts",
    "lint:fix": "eslint js/**/*.ts --fix",
    "format": "prettier --write \"js/**/*.ts\"",
    "format:check": "prettier --check \"js/**/*.ts\"",
    "// Check code quality (lint + format check + type check)": "",
    "check": "npm run lint && npm run format:check && npm run tsc",
    "// Unused code detection": "",
    "knip": "knip",
    "knip:production": "knip --production",
    "ts-prune": "ts-prune",
    "find:unused": "npm run knip",
    "// Duplicate code detection": "",
    "jscpd": "jscpd js/",
    "find:duplicates": "npm run jscpd",
    "// Security and complexity analysis": "",
    "audit": "npm audit --omit=dev",
    "audit:fix": "npm audit fix",
    "security": "npm run audit && npm run lint",
    "// Unit testing with Vitest": "",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "netlify",
    "serverless",
    "proxy",
    "static",
    "envsubst"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/google.maps": "^3.55.0",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "@vitest/ui": "^4.0.16",
    "dotenv": "^16.4.5",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-security": "^3.0.1",
    "happy-dom": "^20.0.11",
    "jscpd": "^4.0.5",
    "knip": "^5.74.0",
    "prettier": "^3.7.4",
    "ts-prune": "^0.10.3",
    "typescript": "^5.3.3",
    "vitest": "^4.0.16"
  }
}
